# Stage 3: DAC subsystem (Phase A IP + SPI master + PIOs + JESD stub).
# dac_subsys.qsys is generated from ip/dac_subsys/dac_subsys.tcl by
# build.tcl's regen step (mtime check); the .qsys is committed as the
# build artifact, the .tcl is the editable source-of-truth.
set_global_assignment -name QSYS_FILE ../../ip/dac_subsys/dac_subsys.qsys


# Variant RTL source files
set_global_assignment -name SYSTEMVERILOG_FILE agilex5_devkit.sv
set_global_assignment -name SYSTEMVERILOG_FILE src/debounce.sv
set_global_assignment -name SYSTEMVERILOG_FILE src/clocks_and_resets.sv


# SDC files
set_global_assignment -name SDC_FILE agilex5_devkit.sdc
set_global_assignment -name SDC_FILE jtag.sdc


# Design Assistant files


# -----------------------------------------------------------------------------
# Stage 4: FMC AD9176-FMC-EBZ pin assignments
#
# CRITICAL (CLAUDE.md SS6 #3): VADJ on the dev kit MUST be 1.2 V before any
# bitstream drives the HSIO 3B LA bus. Pin locations are the FPGA BGA package
# pins as routed by the DK-A5E065BB32AES1 schematic (see AD9176_Dev_Pinout.txt
# 'FPGA FMC Pin Name' / FPGA-package column). The FMC-connector-side pin
# numbers in Agilex_FMC_Pinout.txt (G9, H11 etc.) are VITA 57.1 mezzanine
# coordinates, not FPGA package pins -- those would fail "illegal location
# assignment" at fitter time.
#
# fmc_ga[1:0] (FMC C34/D35) are board pull-ups, not routed to the FPGA on
# this dev kit; intentionally absent from agilex5_devkit.sv and from this qsf.
# -----------------------------------------------------------------------------

# FMC SPI bus to AD9176 (HSIO 3B 1.2-V, 8 mA drive)
set_location_assignment PIN_A54 -to fmc_spi_sck
set_location_assignment PIN_B54 -to fmc_spi_mosi
set_location_assignment PIN_A63 -to fmc_spi_miso
set_location_assignment PIN_B60 -to fmc_spi_cs1_n
set_location_assignment PIN_B56 -to fmc_spi_cs2_n
set_location_assignment PIN_A60 -to fmc_spi_en
set_instance_assignment -name IO_STANDARD "1.2-V" -to fmc_spi_sck
set_instance_assignment -name IO_STANDARD "1.2-V" -to fmc_spi_mosi
set_instance_assignment -name IO_STANDARD "1.2-V" -to fmc_spi_miso
set_instance_assignment -name IO_STANDARD "1.2-V" -to fmc_spi_cs1_n
set_instance_assignment -name IO_STANDARD "1.2-V" -to fmc_spi_cs2_n
set_instance_assignment -name IO_STANDARD "1.2-V" -to fmc_spi_en
set_instance_assignment -name CURRENT_STRENGTH_NEW 8MA -to fmc_spi_sck
set_instance_assignment -name CURRENT_STRENGTH_NEW 8MA -to fmc_spi_mosi
set_instance_assignment -name CURRENT_STRENGTH_NEW 8MA -to fmc_spi_cs1_n
set_instance_assignment -name CURRENT_STRENGTH_NEW 8MA -to fmc_spi_cs2_n
set_instance_assignment -name CURRENT_STRENGTH_NEW 8MA -to fmc_spi_en

# FMC control GPIOs (HSIO 3B 1.2-V, 8 mA drive)
set_location_assignment PIN_M58 -to fmc_txen[0]
set_location_assignment PIN_K58 -to fmc_txen[1]
set_location_assignment PIN_F47 -to fmc_pe_ctrl
set_instance_assignment -name IO_STANDARD "1.2-V" -to fmc_txen[0]
set_instance_assignment -name IO_STANDARD "1.2-V" -to fmc_txen[1]
set_instance_assignment -name IO_STANDARD "1.2-V" -to fmc_pe_ctrl
set_instance_assignment -name CURRENT_STRENGTH_NEW 8MA -to fmc_txen[0]
set_instance_assignment -name CURRENT_STRENGTH_NEW 8MA -to fmc_txen[1]
set_instance_assignment -name CURRENT_STRENGTH_NEW 8MA -to fmc_pe_ctrl

# FMC housekeeping (3.3-V LVCMOS)
# PG_M2C and PG_C2M are routed to the board-mgmt MAX10 FPGA on this dev kit,
# not to the main FPGA, so they are intentionally absent here. The u_pg_c2m_pio
# instance inside dac_subsys is preserved so the HPS can still write to it
# (output dangles inside baseline_top) in case Stage 5 finds firmware needs
# runtime control; the MAX10 likely handles the handshake autonomously.
set_location_assignment PIN_K8 -to fmc_prsnt_n
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to fmc_prsnt_n


# Design partitions assignments
#set_instance_assignment -name PARTITION fabric_subsys -to u_baseline_top|u_fabric_subsys -entity agilex5_devkit
