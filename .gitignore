# Quartus build artifacts
projects/*/output_files/
projects/*/db/
projects/*/incremental_db/
projects/*/qdb/
projects/*/tmp-clearbox/
projects/*/dni/
projects/*/sim_setup_*/
projects/*/build_stage*.log

# Generated IP subdirectories (the .ip files are kept, the regenerated
# tree under each .ip's basename is not). Pattern matches anything that
# is not a known source artifact.
projects/*/ip/baseline_top/
projects/*/ip/fabric_subsys/*/
projects/*/ip/hps_subsys/agilex_hps/
projects/*/ip/hps_subsys/emif_io96b_hps/
projects/*/ip/niosv_subsys/*/
projects/*/ip/shell_subsys/*/
projects/*/baseline_top/
projects/*/fabric_subsys/
projects/*/hps_subsys/
projects/*/niosv_subsys/
projects/*/shell_subsys/
projects/*/.qsys_edit/

# Per-stage generated dac_subsys instance (Stage 3 onward)
ip/dac_subsys/dac_subsys/
ip/dac_controller_0/dac_controller_0/

# Per-instance generated trees under each dac_subsys .ip backing file
# (cmp/csv/html/qgsim*/qgsynth*/qip/sopcinfo/spd/xml/_bb.v/_inst.v|.vhd plus
# sim/ + synth/ subdirs). These are regenerated on every ipgenerate; only
# the sibling .ip files (committed) and the dac_subsys.tcl source (committed)
# are source-of-truth. Same pattern as projects/agilex5_devkit/ip/fabric_subsys/.
ip/dac_subsys/ip/dac_subsys/dac_subsys_u_*/

# Stage 2 SPI smoke-test scratch artifacts (kept on disk for reference but
# never part of the committed build flow).
projects/*/smoke.ip
projects/*/smoke/

# GTS IP port-rotation parameter map: emitted by quartus_ipgenerate when the
# JESD204B GTS IP fits its lanes; regenerated on every full compile and not
# a source-of-truth artifact.
projects/*/sm_hssi_port_rotation_param_map.json

# Simulation artifacts
**/work/
**/transcript
**/*.wlf
**/*.vstf
**/vsim.dbg
**/modelsim.ini.bak
tb_run.log
sim_log.txt

# Questa output spilled into projects/agilex5_devkit/sim/ when running
# probe_license.do or the integration TB (Stage 8). The .mif/.hex/.ini
# files are generated by Questa from the IP cache; libraries/ holds
# precompiled vendor libs. None are source-of-truth.
projects/agilex5_devkit/sim/modelsim.ini
projects/agilex5_devkit/sim/*.mif
projects/agilex5_devkit/sim/*.hex
projects/agilex5_devkit/sim/libraries/

# Validate metadata log
projects/*/validate_metadata_log.txt

# OS / editor cruft
Thumbs.db
.DS_Store
*.swp
*.swo
*~
.vscode/
.idea/

# Local user override / scratch
*.local
scratch/

# Claude Code workspace
.claude/
